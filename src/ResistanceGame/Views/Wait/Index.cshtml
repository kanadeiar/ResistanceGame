@model WaitWebModel
@{
    ViewBag.Title = "Ожидание всех игроков";
}

<h4>@ViewBag.Title</h4>
<p>Согласование темы следующего совещания.</p>

<div id="club" class="mt-3"
     hx-get hx-action="Index"
     hx-route-id="@Model.Id"
     hx-trigger="every 1s">
    <partial name="Partial/WaitPartial" model="Model" />
</div>